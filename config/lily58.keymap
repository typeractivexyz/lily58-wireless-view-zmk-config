#define BASE 0
#define LOWER 1
#define MOUSE_KEYS 2
#define MOUSE_TP 3
#define MOUSE_TP_SET 4
#define GAME 5  // 通用游戏层

#define HAS_MOUSE_KEYS
#define HAS_MOUSE_TP

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow_mods";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        leftclick: leftclick {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFTCLICK";
            #binding-cells = <0>;
            bindings = <&hm LC(SPACE) SPACE>, <&mkp LCLK>;
        };

        mouseclick_keypress: mouseclick_keypress {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSECLICK_KEYPRESS";
            bindings = <&mkp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        // ========== 新增：游戏层切换核心行为 ==========
        // 1. 左拇指键：轻按切Layer1，长按触发游戏层切换（配合右拇指）
        game_layer1: game_layer1 {
            compatible = "zmk,behavior-hold-tap";
            label = "GAME_LAYER1";
            bindings = <&lt 1 TAB>, <&mo 5>;  // 轻按=原&lt1功能，长按=激活游戏层
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";  // 长按优先（避免轻按误触）
        };

        // 2. 右拇指键：轻按切Layer2，长按触发游戏层切换（配合左拇指）
        game_layer2: game_layer2 {
            compatible = "zmk,behavior-hold-tap";
            label = "GAME_LAYER2";
            bindings = <&lt 2 BACKSPACE>, <&mo 5>;  // 轻按=原&lt2功能，长按=激活游戏层
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        // 3. 游戏层退出键（复用双长按逻辑）
        game_exit: game_exit {
            compatible = "zmk,behavior-hold-tap";
            label = "GAME_EXIT";
            bindings = <&trans>, <&to 0>;  // 轻按无反应，长按切回默认层
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ========== 默认层（Layer0）：修改双拇指键为游戏层触发 ==========
        default_layer {
            bindings = <
&kp ESC         &kp N1        &kp N2          &kp N3      &kp N4       &kp N5                                                          &kp N6           &kp N7       &kp N8      &kp N9           &kp N0    &kp BACKSPACE
&kp TAB         &hm ESCAPE Q  &kp W           &kp E       &kp R        &kp T                                                           &kp Y            &kp U        &kp I       &kp O            &kp P     &kp MINUS
&kp LC(LSHIFT)  &kp A         &hm LEFT_ALT S  &hm LGUI D  &hm LSHFT F  &hm LCTRL G                                                     &hm RCTRL H      &hm RSHFT J  &hm RGUI K  &hm RIGHT_ALT L  &kp SEMI  &kp ENTER
&kp GRAVE       &kp Z         &kp X           &kp C       &kp V        &kp B        &hm LA(LC(W)) LBKT    &hm LC(LG(A)) RIGHT_BRACKET  &kp N            &kp M        &kp COMMA   &kp DOT          &kp FSLH  &kp BACKSLASH
                                              &kp LCTRL   &kp LALT     &game_layer1   &hm LGUI ENTER        &hm LC(SPACE) SPACE          &game_layer2     &kp EQUAL    &kp SQT
            >;
        };

        // ========== 原有层：完全不修改 ==========
        symbol {
            bindings = <
&kp F1  &kp F2        &kp F3         &kp F4         &kp F5         &kp F6                                  &kp F7         &kp F8        &kp F9         &kp F10       &kp F11       &kp F12
&trans  &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(DLLR)   &kp LS(PRCNT)                           &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)  &kp LS(RPAR)  &trans
&trans  &kp N1        &kp N2         &kp N3         &kp N4         &kp N5                                  &kp N6         &kp N7        &kp N8         &kp N9        &kp N0        &trans
&trans  &kp GRAVE     &kp LS(TILDE)  &kp MINUS      &kp LS(UNDER)  &kp LBKT       &trans     &trans        &kp RBKT       &kp LS(PLUS)  &kp EQUAL      &kp SQT       &kp LS(DQT)   &trans
                                     &trans         &trans         &trans         &kp RET    &kp LS(PIPE)  &kp BSLH       &kp FSLH      &kp LS(QMARK)
            >;
        };

        navi {
            bindings = <
&trans     &trans         &trans         &trans         &trans  &trans                    &trans             &trans           &trans            &trans           &trans     &trans
&kp GRAVE  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &kp N4  &kp N5                    &kp PAGE_DOWN      &kp PAGE_UP      &kp LG(KP_MINUS)  &kp LG(KP_PLUS)  &kp N0     &trans
&trans     &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &trans  &trans                    &kp LEFT           &kp DOWN         &kp UP_ARROW      &kp RIGHT        &kp RIGHT  &trans
&trans     &bt BT_CLR     &trans         &trans         &trans  &trans  &trans    &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp EQUAL         &kp LBKT         &kp RBKT   &kp BSLH
                                         &trans         &trans  &trans  &trans    &trans  &trans             &trans           &trans
            >;
        };

        mouse_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &none   &none   &none   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &none   &none   &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        // ========== 通用游戏层（Layer5）：左手全基础键 + 双长按退出 ==========
        game_layer {
            bindings = <
&kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                     &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T                       &kp Y    &kp U    &kp I    &kp O    &kp P    &kp MINUS
&kp LSHIFT&kp A    &kp S    &kp D    &kp F    &kp G                       &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp ENTER
&kp GRAVE &kp Z    &kp X    &kp C    &kp V    &kp B     &kp LBKT  &kp RBKT  &kp N    &kp M    &kp COMMA&kp DOT  &kp FSLH  &kp BSLH
                        &kp LCTRL &kp LALT &game_exit   &kp SPACE &kp ENTER  &game_exit &kp RALT &kp RCTRL
            >;
        };
    };
};
