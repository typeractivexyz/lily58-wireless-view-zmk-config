#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/*
 * Lily58 — 3 layers (Base / Lower / Raise), rotary encoder on the LEFT half.
 *
 * Layer access:  hold LOWER (left thumb, `&mo 1`)  ·  hold RAISE (right thumb, `&mo 2`)
 *
 * The "ENC" cell is the left inner-bottom dead slot (no switch fitted). It holds a
 * marker keycode per layer purely so keymap-drawer draws the encoder knob — see
 * CLAUDE.md. The real encoder action is the `sensor-bindings` line on each layer.
 */

/* Homerow mods — urob's "timeless" recipe. See docs/timeless-homerow-mods.md.
 *
 * The tapping term is deliberately long and is NOT what decides tap vs hold:
 *   - balanced          — another key pressed AND released while held = mod, resolves instantly
 *   - prior-idle 150ms  — pressed right after another key = letter, no delay while typing
 *   - trigger positions — next key on the same hand = a roll, so force a letter
 *   - on-release        — defers that check to release, so same-hand mods can still stack
 *   - quick-tap 225ms   — re-pressing the same key after tapping it stays a letter (ff, ll)
 *
 * Position 42 is omitted from KEYS_L: it is the encoder's dead slot, no switch fitted.
 */
#define KEYS_L  0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
#define KEYS_R  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49
#define THUMBS 50 51 52 53 54 55 56 57

/ {
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <225>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <225>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ## Base
         *
         * |  L1   |  L2  | L3  |  L4  |  L5  |  L6  |  ENC  |  R0  |  R1  |  R2  |  R3  | R4  |  R5  |  R6   |
         * |-------|------|-----|------|------|------|-------|------|------|------|------|-----|------|-------|
         * | `     |  1   |  2  |  3   |  4   |  5   |       |      |  6   |  7   |  8   |  9  |  0   |  -    |
         * | TAB   |  Q   |  W  |  E   |  R   |  T   |       |      |  Y   |  U   |  I   |  O  |  P   |  =    |
         * | ESC   |  A   |  S  |  D   |  F   |  G   |       |      |  H   |  J   |  K   |  L  |  ;   | BSPC  |
         * | LCTRL |  Z   |  X  |  C   |  V   |  B   |  scrl |  '   |  N   |  M   |  ,   |  .  |  /   | RSHFT |
         *
         * Homerow mods on row 3 — tap = letter, hold = modifier:
         *
         * |  A  |  S  |  D  |  F  |     |  J  |  K  |  L  |  ;  |
         * |-----|-----|-----|-----|-----|-----|-----|-----|-----|
         * |  ⌃  |  ⇧  |  ⌥  |  ⌘  |     |  ⌘  |  ⌥  |  ⇧  |  ⌃  |
         *
         * |  LT1  |  LT2  |  LT3  |  LT4  |  RT1  |  RT2  |  RT3  |  RT4  |
         * |-------|-------|-------|-------|-------|-------|-------|-------|
         * | ⌥ / ↑ | ⌘ / ↓ | LOWER | SPACE | ENTER | RAISE |  ←    |  →    |
         *
         * ⌥ / ↑ and ⌘ / ↓ are mod-taps: tap = arrow, hold = modifier.
         * Encoder: PAGE UP / PAGE DOWN.
         */

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3       &kp N4         &kp N5                              &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E        &kp R          &kp T                               &kp Y   &kp U     &kp I      &kp O    &kp P     &kp EQUAL
&kp ESCAPE  &hml LCTRL A  &hml LSHFT S  &hml LALT D  &hml LGUI F  &kp G                     &kp H   &hmr RGUI J  &hmr RALT K  &hmr RSHFT L  &hmr RCTRL SEMI  &kp BACKSPACE
&kp LCTRL   &kp Z   &kp X   &kp C        &kp V          &kp B   &kp SCROLLLOCK    &kp APOS  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                            &mt LALT UP  &mt LGUI DOWN  &mo 1   &kp SPACE         &kp RET   &mo 2   &kp LEFT  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        /*
         * ## Lower — vim arrows only, everything else transparent
         *
         * |  L1   |  L2  | L3  |  L4  |  L5  |  L6  |  ENC  |  R0  |  R1  |  R2  |  R3  | R4  |  R5  |  R6   |
         * |-------|------|-----|------|------|------|-------|------|------|------|------|-----|------|-------|
         * |       |      |     |      |      |      |       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |  ←   |  ↓   |  ↑   |  →  |      |       |
         * |       |      |     |      |      |      | brght |      |      |      |      |     |      |       |
         *
         * Arrows sit on H / J / K / L. Encoder: brightness up / down.
         */

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_AUTO    &trans  &trans    &trans    &trans  &trans     &trans  &trans
                        &trans  &trans  &trans  &trans                   &trans  &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        /*
         * ## Raise — Bluetooth profiles, media, symbols
         *
         * |  L1   |  L2  | L3  |  L4  |  L5  |  L6  |  ENC  |  R0  |  R1  |  R2  |  R3  | R4  |  R5  |  R6   |
         * |-------|------|-----|------|------|------|-------|------|------|------|------|-----|------|-------|
         * |       | BT 0 | BT 1| BT 2 |      | BTCLR|       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |  ^   |  &   |  *   |  (  |  )   |  ~    |
         * |       |      |     |      |  ⏮   |  ⏭   |  vol  |      |      |  -   |  +   |  {  |  }   |  \|   |
         *
         * |  LT1  |  LT2  |  LT3  |  LT4  |  RT1  |  RT2  |  RT3  |  RT4  |
         * |-------|-------|-------|-------|-------|-------|-------|-------|
         * |       |       |       |  ⏯    |       |       |       |       |
         *
         * BT 0-2 select a host profile; BTCLR clears the bond on the active one.
         * Encoder: volume up / down.
         */

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans      &bt BT_CLR                              &trans     &trans     &trans           &trans    &trans    &trans
&trans  &trans        &trans        &trans        &trans      &trans                                  &trans     &trans     &trans           &trans    &trans    &trans
&trans  &trans        &trans        &trans        &trans      &trans                                  &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp TILDE
&trans  &trans        &trans        &trans        &kp C_PREV  &kp C_NEXT  &kp K_MUTE          &trans  &trans     &kp MINUS  &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE
                                    &trans        &trans      &trans      &kp C_PLAY_PAUSE    &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
